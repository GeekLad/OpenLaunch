# Required for IPFS Upload (choose one):
# To use Pinata:
PINATA_API_KEY=
PINATA_SECRET_KEY=

# To use Filebase:
FILEBASE_API_KEY=

# Optional overrides (defaults are sensible and baked in via config/public.ts):
# RPC_URL=                  # Custom Solana RPC endpoint (server-only)
# DATA_DIR=./data           # SQLite storage path
# ENABLE_CRON=true          # Background fee updates
