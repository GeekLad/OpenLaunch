# Application Configuration
# The name of your launchpad application (default: OpenLaunch)
NEXT_PUBLIC_APP_NAME=OpenLaunch

# Solana RPC Configuration
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Fixed Quote Token (SOL Wrapped Mint)
NEXT_PUBLIC_QUOTE_TOKEN_MINT=So11111111111111111111111111111111111111112

# Token Configuration
NEXT_PUBLIC_TOKEN_DECIMALS=9
NEXT_PUBLIC_TOTAL_SUPPLY=1000000000

# Metadata Configuration
# Set to 'true' to allow metadata updates after token creation (default: false)
# WARNING: Setting this to 'true' makes metadata mutable, which may reduce trust
# For maximum security and immutability, keep this set to false or unset
# NEXT_PUBLIC_METADATA_MUTABLE=true

# Pricing Configuration
# Defeault initial price and minimum set the starting market cap at 100 SOL
NEXT_PUBLIC_INITIAL_PRICE=0.0000001
NEXT_PUBLIC_PRICE_RANGE_MIN=0.0000001
# The max price range is set at a market cap of 1,000,000 SOL
NEXT_PUBLIC_PRICE_RANGE_MAX=0.001

# Fee Schedule Configuration
NEXT_PUBLIC_FEE_DECAY_DURATION_MINUTES=60
# Number of periods for fee decay (more periods = more frequent fee changes)
# Example: 5 minutes with 60 periods = fee changes every 5 seconds
# Example: 5 minutes with 10 periods = fee changes every 30 seconds (default)
NEXT_PUBLIC_FEE_DECAY_PERIODS=60

# Pool Configuration
# Percentage of token supply allocated to initial pool liquidity (0.0 to 1.0)
NEXT_PUBLIC_POOL_LIQUIDITY_PERCENTAGE=1

# Maximum image file size in MB (default: 1)
# This limits the size of logo images that can be uploaded
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB=1

# Upload Options (choose ONE - both are FREE):

# Option 1: Filebase (RECOMMENDED - 5GB free + S3-compatible IPFS)
# Sign up at https://filebase.com (free tier available)
# Get API key from dashboard at https://console.filebase.com/keys
# FILEBASE_API_KEY=your_filebase_api_key

# Option 2: Pinata (1GB free storage)
# Sign up at https://pinata.cloud
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_KEY=your_pinata_secret_key